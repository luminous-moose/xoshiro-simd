opam-version: "2.0"
version: "0.1.0"
synopsis: "SIMD-accelerated xoshiro256 PRNG"
description: """
A fast, non-cryptographic pseudo-random number generator using SIMD-accelerated
xoshiro256++ (integer output) and xoshiro256+ (float output), with bulk
Bigarray fill functions and an interface compatible with the OCaml standard
Random module."""
maintainer: ["Chris A <onetimerobot@protonmail.com>"]
authors: ["Chris A <onetimerobot@protonmail.com>"]
x-maintenance-intent: ["(latest)"]
license: "ISC"
homepage: "https://github.com/luminous-moose/xoshiro-simd"
dev-repo: "git+https://github.com/luminous-moose/xoshiro-simd.git"
bug-reports: "https://github.com/luminous-moose/xoshiro-simd/issues"
tags: ["random" "prng" "xoshiro" "simd"]
depends: [
  "ocaml" {>= "4.13.0"}
  "dune" {>= "3.15.3"}
  "base" {with-test & >= "v0.14.1"}
  "stdio" {with-test & >= "v0.14.0"}
  "hex" {with-test & >= "1.3.0"}
  "ppx_expect" {with-test & >= "v0.14.1"}
  "ppx_inline_test" {with-test & >= "v0.14.1"}
  "odoc" {with-doc & >= "2.1.1"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
