opam-version: "2.0"
synopsis: "Dependencies for building and running xoshiro-simd's benchmarks"
description: """
Not a package to install or publish -- this exists only to declare the
extra comparison libraries needed to build bench/ (bechamel, cppo,
splittable_random, pringo, xoshiro, base). It has no build steps of its own.

gsl and owl are deliberately not listed here: neither builds on every
platform, so bench/sync_optional_deps.py keeps bench/dune in sync with whether
they're actually installed instead of requiring them outright. Install them
separately if you want those two comparisons as well.

The stanzas in bench/dune are gated on `--profile bench`, so a plain
`dune build` never needs any of this. To build/run the benchmarks:
opam install ./xoshiro-simd-bench.opam --deps-only, then from
within bench/, run `make`."""
maintainer: ["Chris A <onetimerobot@protonmail.com>"]
authors: ["Chris A <onetimerobot@protonmail.com>"]
license: "ISC"
homepage: "https://github.com/luminous-moose/xoshiro-simd"
dev-repo: "git+https://github.com/luminous-moose/xoshiro-simd.git"
bug-reports: "https://github.com/luminous-moose/xoshiro-simd/issues"
depends: [
  "ocaml" {>= "4.13.0"}
  "dune" {>= "3.10.0"}
  "bechamel"
  "cppo"
  "splittable_random"
  "pringo"
  "xoshiro"
  "base"
]
build: []
