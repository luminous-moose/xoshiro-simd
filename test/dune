(library
 (name xoshiro_simd_tests)
 (modules
  float_fmt
  list_extra
  test_sampling
  test_primitives
  test_numeric
  test_backend
  test_state
  test_seeding
  seed_reverse
  test_vectors
  lemire_ref
  test_lemire_reference)
 (libraries base stdio hex unix compiler-libs.common xoshiro-simd)
 (foreign_stubs
  (language c)
  (names lemire_ref_stubs))
 (inline_tests
  (deps
   (glob_files ../testvectors/*.txt))
  (flags
   (:include runner_flags.sexp)))
 (flags :standard -alert -testing)
 (preprocess
  (pps ppx_expect ppx_inline_test)))

;; ppx_inline_test's built-in word-size tags only mark a test; the runner
;; drops nothing but "disabled" unless told to, so pass the matching -drop-tag
;; here. A test tagged [@tags "64-bits-only"] then doesn't run on 32-bit hosts.
(rule
 (enabled_if %{arch_sixtyfour})
 (action
  (with-stdout-to
   runner_flags.sexp
   (echo "(-drop-tag 32-bits-only)"))))

(rule
 (enabled_if
  (not %{arch_sixtyfour}))
 (action
  (with-stdout-to
   runner_flags.sexp
   (echo "(-drop-tag 64-bits-only)"))))

(test
 (name test_init)
 (modules test_init)
 (libraries xoshiro-simd))

(test
 (name test_domain)
 (modules test_domain)
 (flags :standard -alert -testing)
 (libraries xoshiro-simd))

;; The /dev/urandom fallback in read_entropy: getrandom_enosys_shim.so is
;; LD_PRELOADed so every getrandom() and getentropy() fails and the fallback
;; supplies all the entropy urandom_fallback_probe.exe asks for. Built on every
;; Unix except macOS, but check_urandom_fallback.sh only runs on Linux and the
;; BSDs, and skips (exit 0) elsewhere. macOS is excluded from the build too:
;; the shims define libc's own functions and have never been compiled against
;; Apple's headers. An executable plus a runtest rule rather than a (test ...)
;; stanza, because it has to run under the shim.
(rule
 (enabled_if
  (and
   (= %{os_type} Unix)
   (<> %{system} macosx)))
 (targets getrandom_enosys_shim.so)
 (deps getrandom_enosys_shim.c)
 (action
  (run %{cc} -shared -fPIC -o %{targets} %{deps})))

;; The second run's library: getrandom_enosys_shim.c plus
;; urandom_eintr_shim.c, which makes the first read() from each /dev/urandom
;; descriptor fail with EINTR. Built by a script because dlsym needs -ldl on
;; Linux only.
(rule
 (enabled_if
  (and
   (= %{os_type} Unix)
   (<> %{system} macosx)))
 (targets urandom_eintr_shim.so)
 (deps build_eintr_shim.sh getrandom_enosys_shim.c urandom_eintr_shim.c)
 (action
  (run bash build_eintr_shim.sh %{targets} %{cc})))

(executable
 (name urandom_fallback_probe)
 (modules urandom_fallback_probe)
 (libraries xoshiro-simd)
 (enabled_if
  (and
   (= %{os_type} Unix)
   (<> %{system} macosx))))

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{os_type} Unix)
   (<> %{system} macosx)))
 (deps
  check_urandom_fallback.sh
  getrandom_enosys_shim.so
  urandom_eintr_shim.so
  urandom_fallback_probe.exe)
 (action
  (run
   bash
   check_urandom_fallback.sh
   getrandom_enosys_shim.so
   urandom_eintr_shim.so
   ./urandom_fallback_probe.exe)))

