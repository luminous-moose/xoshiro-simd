;; Uses Domain directly, so OCaml 5 only.
(test
 (name test_domain_tree)
 (modules test_domain_tree)
 (enabled_if
  (>= %{ocaml_version} 5))
 (libraries xoshiro-simd))

;; Spawning domains reads no OS entropy: the same getrandom_enosys_shim.so
;; counts the reads with and without spawns. OCaml 5 only, since it needs
;; domains, and Unix except macOS only, for LD_PRELOAD and the shim.
(executable
 (name spawn_entropy_probe)
 (modules spawn_entropy_probe)
 (libraries xoshiro-simd)
 (enabled_if
  (and
   (= %{os_type} Unix)
   (<> %{system} macosx)
   (>= %{ocaml_version} 5))))

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{os_type} Unix)
   (<> %{system} macosx)
   (>= %{ocaml_version} 5)))
 (deps
  check_spawn_entropy_reads.sh
  getrandom_enosys_shim.so
  spawn_entropy_probe.exe)
 (action
  (run
   bash
   check_spawn_entropy_reads.sh
   getrandom_enosys_shim.so
   ./spawn_entropy_probe.exe)))

;; Bigarray.float16 doesn't exist as a type before OCaml 5.2, so this can't
;; compile unconditionally the way the other kind-specific bigarray tests in
;; test_primitives.ml do -- see test_float16_bigarray.ml's own comment.
;;
;; Deliberately an (executable ...) + (rule (alias runtest) ...) pair
;; instead of a (test ...) stanza: since dune 3.22.0 (#13081), enabled_if on
;; a test/tests stanza only controls @runtest inclusion, not whether plain
;; `dune build` compiles it -- which would break the OCaml-4 build outright,
;; the exact thing enabled_if here exists to prevent. enabled_if on an
;; executable stanza still gates compilation itself.
(executable
 (name test_float16_bigarray)
 (modules test_float16_bigarray)
 (libraries xoshiro-simd)
 (enabled_if
  (>= %{ocaml_version} 5.2)))

(rule
 (alias runtest)
 (enabled_if
  (>= %{ocaml_version} 5.2))
 (deps test_float16_bigarray.exe)
 (action
  (run %{deps})))

;; Guards against xs256simd_/xs256simdintf_ symbol-prefix regression: an
;; unprefixed cross-file C symbol compiles clean and passes every ordinary test,
;; because nothing about it is wrong until this library is statically linked
;; into the same native executable as another library that happens to define an
;; identically-named symbol. Checking the archive's exported symbol list
;; directly catches a new unprefixed global the moment it's introduced, rather
;; than waiting for an accidental collision. Runs as part of the default
;; @runtest alias -- nm is ordinary toolchain tooling, not special host
;; setup, so there's no reason to gate it behind an opt-in alias.
(rule
 (alias runtest)
 (deps
  check_exported_symbols.sh
  ../lib/libxoshiro_simd_stubs.a)
 (action
  (run bash check_exported_symbols.sh ../lib/libxoshiro_simd_stubs.a)))

;; Reads the real, dune-generated user_extra_cflags.sexp (produced by the
;; XOSHIRO_SIMD_EXTRA_CFLAGS rule in lib/dune) and checks it against a
;; prediction computed independently in the shell, so a typo in the env var
;; name in lib/dune -- which would silently always resolve to empty -- gets
;; caught here. Needs no special host setup.
(rule
 (alias runtest)
 (deps
  check_extra_cflags_dune_wiring.sh
  ../lib/user_extra_cflags.sexp)
 (action
  (run bash check_extra_cflags_dune_wiring.sh ../lib/user_extra_cflags.sexp)))

;; The checks above don't prove every SIMD backend actually *reads*
;; user_extra_cflags.sexp -- lib/dune has five separate (foreign_stubs ...)
;; stanzas (baseline + sse2/avx2/avx512fvl/neon), each needing its own
;; (:include user_extra_cflags.sexp) in its flags list. A missing or
;; misspelled :include in any one of them would silently mean that backend
;; alone never receives XOSHIRO_SIMD_EXTRA_CFLAGS, with nothing else able to
;; catch it. This counts occurrences of each rather than hardcoding a
;; specific number, so it doesn't need updating when a backend is added or
;; removed -- only the two counts need to keep matching.
(rule
 (alias runtest)
 (deps
  check_extra_cflags_include_wiring.sh
  ../lib/dune)
 (action
  (run bash check_extra_cflags_include_wiring.sh ../lib/dune)))
